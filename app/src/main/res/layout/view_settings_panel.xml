<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#40000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <ScrollView
        android:id="@+id/panel"
        android:layout_width="460dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/panel_background"
        android:clickable="true"
        android:fadeScrollbars="false"
        android:focusable="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_title"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/panelClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_secondary_button"
                    android:contentDescription="@string/close"
                    android:padding="12dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <Button
                android:id="@+id/panelTransfer"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="64dp"
                android:text="@string/transfer_photos"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/transfer_photos_hint"
                android:textColor="@color/text_hint"
                android:textSize="14sp" />

            <TextView
                style="@style/PanelSectionTitle"
                android:text="@string/section_effect" />

            <LinearLayout
                android:id="@+id/effectChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/PanelSectionTitle"
                android:text="@string/section_interval" />

            <LinearLayout
                android:id="@+id/intervalChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/PanelSectionTitle"
                android:text="@string/section_order" />

            <LinearLayout
                android:id="@+id/orderChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/PanelSectionTitle"
                android:text="@string/section_scale" />

            <LinearLayout
                android:id="@+id/scaleChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/PanelSectionTitle"
                android:text="@string/section_clock" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/clockSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/show_clock"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                style="@style/PanelSectionTitle"
                android:text="@string/section_sleep" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sleepSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sleep_enabled"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/sleepTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/sleepStartButton"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/sleepEndButton"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/photoStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/systemSettingsButton"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/system_settings" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
